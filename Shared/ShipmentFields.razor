<div class="fd-card">
    <div class="fd-card-title">Booking</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="invoiceNo">Invoice no.</label>
            <InputNumber id="invoiceNo" class="form-control" min="1" @bind-Value="Model.InvoiceNo" />
            <ValidationMessage For="@(() => Model.InvoiceNo)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label required" for="jobRef">Job reference</label>
            <InputText id="jobRef" class="form-control" @bind-Value="Model.JobReferenceNumber" />
            <ValidationMessage For="@(() => Model.JobReferenceNumber)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label required" for="bookingNo">Booking number</label>
            <InputText id="bookingNo" class="form-control" @bind-Value="Model.BookingNumber" />
            <ValidationMessage For="@(() => Model.BookingNumber)" />
        </div>
        @if (MoreContainers == null)
        {
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label required" for="containerNo">Container number</label>
                <InputText id="containerNo" class="form-control text-uppercase" placeholder="e.g. MSCU1234566" @bind-Value="Model.ContainerNumber" />
                <ValidationMessage For="@(() => Model.ContainerNumber)" />
            </div>
        }
        else
        {
            <div class="col-12">
                <label class="form-label required" for="containerNo">
                    @(MoreContainers.Count == 0 ? "Container number" : $"Containers ({MoreContainers.Count + 1})")
                </label>
                <div class="row g-2">
                    <div class="col-sm-6 col-xl-4">
                        <InputText id="containerNo" class="form-control text-uppercase" placeholder="e.g. MSCU1234566" @bind-Value="Model.ContainerNumber" />
                        <ValidationMessage For="@(() => Model.ContainerNumber)" />
                    </div>
                    @for (var i = 0; i < MoreContainers.Count; i++)
                    {
                        var entry = MoreContainers[i];
                        var position = i + 2;
                        <div class="col-sm-6 col-xl-4" @key="entry">
                            <div class="input-group">
                                <input class="form-control text-uppercase @(entry.Error == null ? "" : "invalid")" value="@entry.Number"
                                       aria-label="Container @position" placeholder="Container @position"
                                       @onchange="e => UpdateContainer(entry, e.Value as string)" />
                                <button type="button" class="btn btn-outline-secondary" aria-label="Remove container @position"
                                        @onclick="() => RemoveContainer(entry)">
                                    <span class="oi oi-x" aria-hidden="true"></span>
                                </button>
                            </div>
                            @if (entry.Error != null)
                            {
                                <div class="validation-message">@entry.Error</div>
                            }
                        </div>
                    }
                </div>
                <button type="button" class="btn btn-link btn-sm px-0 mt-1" @onclick="AddContainer">
                    <span class="oi oi-plus" aria-hidden="true"></span> Add another container
                </button>
                <div class="form-text">Each container is saved as its own shipment with the details below.</div>
            </div>
        }
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">Parties &amp; route</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xl-4">
            <label class="form-label required" for="client">Client</label>
            <LookupPicker Id="client" ItemLabel="client" Placeholder="Search clients"
                          Items="@(Clients.Select(c => new LookupPicker.Option(c.Id, c.Name)).ToList())"
                          Value="@(Model.ClientId == 0 ? null : Model.ClientId)"
                          ValueChanged="@(id => SetField(() => Model.ClientId, () => Model.ClientId = id ?? 0))"
                          CssClass="@EditContext?.FieldCssClass(() => Model.ClientId)"
                          OnCreate="@CreateHandler(QuickAddKind.Client)" />
            <ValidationMessage For="@(() => Model.ClientId)" />
        </div>
        <div class="col-sm-6 col-xl-4">
            <label class="form-label required" for="carrier">Carrier</label>
            <LookupPicker Id="carrier" ItemLabel="carrier" Placeholder="Search carriers"
                          Items="@(Carriers.Select(c => new LookupPicker.Option(c.Id, c.Name)).ToList())"
                          Value="@Model.CarrierId"
                          ValueChanged="@(id => SetField(() => Model.CarrierId, () => Model.CarrierId = id))"
                          CssClass="@EditContext?.FieldCssClass(() => Model.CarrierId)"
                          OnCreate="@CreateHandler(QuickAddKind.Carrier)" />
            <ValidationMessage For="@(() => Model.CarrierId)" />
        </div>
        <div class="col-sm-6 col-xl-4">
            <label class="form-label required" for="port">Destination port</label>
            <LookupPicker Id="port" ItemLabel="port" Placeholder="Search ports"
                          Items="@(Ports.Select(p => new LookupPicker.Option(p.Id, p.Name)).ToList())"
                          Value="@(Model.PortId == 0 ? null : Model.PortId)"
                          ValueChanged="@(id => SetField(() => Model.PortId, () => Model.PortId = id ?? 0))"
                          CssClass="@EditContext?.FieldCssClass(() => Model.PortId)"
                          OnCreate="@CreateHandler(QuickAddKind.Port)" />
            <ValidationMessage For="@(() => Model.PortId)" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">Cargo</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="qty">Quantity</label>
            <InputNumber id="qty" class="form-control" min="0" step="any" @bind-Value="Model.CargoQuantity" />
            <ValidationMessage For="@(() => Model.CargoQuantity)" />
        </div>
        <div class="col-sm-6 col-xxl-9">
            <label class="form-label" for="cargoDesc">Description</label>
            <InputText id="cargoDesc" class="form-control" @bind-Value="Model.CargoDescription" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">Schedule</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="invDate">Invoice date</label>
            <InputDate id="invDate" class="form-control" @bind-Value="Model.InvoiceDate" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="cutoff">Cut-off date</label>
            <InputDate id="cutoff" class="form-control" @bind-Value="Model.CutOffDate" />
            <ValidationMessage For="@(() => Model.CutOffDate)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="sailing">Sailing</label>
            <InputDate id="sailing" class="form-control" @bind-Value="Model.Sailing" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="arrival">Arrival</label>
            <InputDate id="arrival" class="form-control" @bind-Value="Model.Arrival" />
            <ValidationMessage For="@(() => Model.Arrival)" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">@(ShowLifecycle ? "Billing & release" : "Billing")</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="price">@(MoreContainers is { Count: > 0 } ? "Price per container" : "Price")</label>
            <InputNumber id="price" class="form-control" min="0" step="0.01" @bind-Value="Model.Price" />
            <ValidationMessage For="@(() => Model.Price)" />
        </div>
        @if (ShowLifecycle)
        {
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label" for="paidDate">Payment received</label>
                <InputDate id="paidDate" class="form-control" @bind-Value="Model.PaymentReceivedDate" />
            </div>
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label" for="paidCarrier">Paid to carrier</label>
                <InputDate id="paidCarrier" class="form-control" @bind-Value="Model.PaidToCarrierDate" />
            </div>
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label" for="released">Released</label>
                <InputDate id="released" class="form-control" @bind-Value="Model.ReleaseDate" />
            </div>
        }
        <div class="col-12">
            <label class="form-label" for="notes">Notes</label>
            <InputTextArea id="notes" class="form-control" rows="3" @bind-Value="Model.Notes" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Shipment Model { get; set; } = default!;
    [Parameter] public IReadOnlyList<Client> Clients { get; set; } = Array.Empty<Client>();
    [Parameter] public IReadOnlyList<Carrier> Carriers { get; set; } = Array.Empty<Carrier>();
    [Parameter] public IReadOnlyList<Port> Ports { get; set; } = Array.Empty<Port>();

    /// <summary>Payment, carrier-payment and release dates happen after registration, so the create page hides them.</summary>
    [Parameter] public bool ShowLifecycle { get; set; } = true;

    [CascadingParameter] private EditContext? EditContext { get; set; }

    /// <summary>When set, the pickers offer to add a client, carrier or port that is not in the list yet.</summary>
    [Parameter] public EventCallback<QuickAddRequest> OnQuickAdd { get; set; }

    private EventCallback<string> CreateHandler(QuickAddKind kind) => OnQuickAdd.HasDelegate
        ? EventCallback.Factory.Create<string>(this, name => OnQuickAdd.InvokeAsync(new QuickAddRequest(kind, name)))
        : default;

    // The pickers are not InputBase components, so tell the form a field changed (validation, summary panel).
    private void SetField<T>(System.Linq.Expressions.Expression<Func<T>> field, Action assign)
    {
        assign();
        EditContext?.NotifyFieldChanged(FieldIdentifier.Create(field));
    }

    /// <summary>Extra containers on the same booking (create page only); null hides the option.</summary>
    [Parameter] public List<ContainerEntry>? MoreContainers { get; set; }
    [Parameter] public EventCallback ContainersChanged { get; set; }

    private Task AddContainer()
    {
        MoreContainers!.Add(new ContainerEntry());
        return ContainersChanged.InvokeAsync();
    }

    private Task RemoveContainer(ContainerEntry entry)
    {
        MoreContainers!.Remove(entry);
        return ContainersChanged.InvokeAsync();
    }

    private Task UpdateContainer(ContainerEntry entry, string? value)
    {
        entry.Number = value ?? "";
        entry.Error = null;
        return ContainersChanged.InvokeAsync();
    }
}
