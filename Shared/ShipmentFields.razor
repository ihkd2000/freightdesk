<div class="fd-card">
    <div class="fd-card-title">Booking</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="invoiceNo">Invoice no.</label>
            <InputNumber id="invoiceNo" class="form-control" min="1" @bind-Value="Model.InvoiceNo" />
            <ValidationMessage For="@(() => Model.InvoiceNo)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label required" for="jobRef">Job reference</label>
            <InputText id="jobRef" class="form-control" @bind-Value="Model.JobReferenceNumber" />
            <ValidationMessage For="@(() => Model.JobReferenceNumber)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label required" for="bookingNo">Booking number</label>
            <InputText id="bookingNo" class="form-control" @bind-Value="Model.BookingNumber" />
            <ValidationMessage For="@(() => Model.BookingNumber)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label required" for="containerNo">Container number</label>
            <InputText id="containerNo" class="form-control text-uppercase" placeholder="e.g. MSCU1234566" @bind-Value="Model.ContainerNumber" />
            <ValidationMessage For="@(() => Model.ContainerNumber)" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">Parties &amp; route</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xl-4">
            <label class="form-label required" for="client">Client</label>
            <InputSelect id="client" class="form-select" @bind-Value="Model.ClientId">
                <option value="0">Select a client</option>
                @foreach (var client in Clients)
                {
                    <option value="@client.Id">@client.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.ClientId)" />
        </div>
        <div class="col-sm-6 col-xl-4">
            <label class="form-label required" for="carrier">Carrier</label>
            <InputSelect id="carrier" class="form-select" @bind-Value="Model.CarrierId">
                <option value="">Select a carrier</option>
                @foreach (var carrier in Carriers)
                {
                    <option value="@carrier.Id">@carrier.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.CarrierId)" />
        </div>
        <div class="col-sm-6 col-xl-4">
            <label class="form-label required" for="port">Destination port</label>
            <InputSelect id="port" class="form-select" @bind-Value="Model.PortId">
                <option value="0">Select a port</option>
                @foreach (var port in Ports)
                {
                    <option value="@port.Id">@port.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.PortId)" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">Cargo</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="qty">Quantity</label>
            <InputNumber id="qty" class="form-control" min="0" step="any" @bind-Value="Model.CargoQuantity" />
            <ValidationMessage For="@(() => Model.CargoQuantity)" />
        </div>
        <div class="col-sm-6 col-xxl-9">
            <label class="form-label" for="cargoDesc">Description</label>
            <InputText id="cargoDesc" class="form-control" @bind-Value="Model.CargoDescription" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">Schedule</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="invDate">Invoice date</label>
            <InputDate id="invDate" class="form-control" @bind-Value="Model.InvoiceDate" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="cutoff">Cut-off date</label>
            <InputDate id="cutoff" class="form-control" @bind-Value="Model.CutOffDate" />
            <ValidationMessage For="@(() => Model.CutOffDate)" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="sailing">Sailing</label>
            <InputDate id="sailing" class="form-control" @bind-Value="Model.Sailing" />
        </div>
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="arrival">Arrival</label>
            <InputDate id="arrival" class="form-control" @bind-Value="Model.Arrival" />
            <ValidationMessage For="@(() => Model.Arrival)" />
        </div>
    </div>
</div>

<div class="fd-card">
    <div class="fd-card-title">@(ShowLifecycle ? "Billing & release" : "Billing")</div>
    <div class="row g-3">
        <div class="col-sm-6 col-xxl-3">
            <label class="form-label" for="price">Price</label>
            <InputNumber id="price" class="form-control" min="0" step="0.01" @bind-Value="Model.Price" />
            <ValidationMessage For="@(() => Model.Price)" />
        </div>
        @if (ShowLifecycle)
        {
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label" for="paidDate">Payment received</label>
                <InputDate id="paidDate" class="form-control" @bind-Value="Model.PaymentReceivedDate" />
            </div>
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label" for="paidCarrier">Paid to carrier</label>
                <InputDate id="paidCarrier" class="form-control" @bind-Value="Model.PaidToCarrierDate" />
            </div>
            <div class="col-sm-6 col-xxl-3">
                <label class="form-label" for="released">Released</label>
                <InputDate id="released" class="form-control" @bind-Value="Model.ReleaseDate" />
            </div>
        }
        <div class="col-12">
            <label class="form-label" for="notes">Notes</label>
            <InputTextArea id="notes" class="form-control" rows="3" @bind-Value="Model.Notes" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Shipment Model { get; set; } = default!;
    [Parameter] public IReadOnlyList<Client> Clients { get; set; } = Array.Empty<Client>();
    [Parameter] public IReadOnlyList<Carrier> Carriers { get; set; } = Array.Empty<Carrier>();
    [Parameter] public IReadOnlyList<Port> Ports { get; set; } = Array.Empty<Port>();

    /// <summary>Payment, carrier-payment and release dates happen after registration, so the create page hides them.</summary>
    [Parameter] public bool ShowLifecycle { get; set; } = true;
}
