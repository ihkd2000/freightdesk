@page "/admin/users/{userId}/roles"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Edit roles</PageTitle>

<PageHeader Title="Edit roles" Subtitle="@user?.Email" />

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (user == null || allRoles == null || selectedRoles == null)
{
    <p>Loading...</p>
}
else
{
    <div class="fd-card" style="max-width: 460px;">
    <div class="fd-card-title">Roles</div>
    <form @onsubmit="HandleSubmit">
        @foreach (var role in allRoles)
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="role-@role" @bind="selectedRoles[role]" />
                <label class="form-check-label" for="role-@role">@role</label>
            </div>
        }
        <div class="form-actions mt-3"><button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-secondary" href="/admin/users">Cancel</a></div>
    </form>
    </div>
}

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;

    private IdentityUser? user;
    private List<string>? allRoles;
    private Dictionary<string, bool>? selectedRoles;
    private string? currentUserName;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserName = state.User.Identity?.Name;

        user = await UserManager.FindByIdAsync(UserId);
        if (user != null)
        {
            allRoles = RoleManager.Roles.Select(r => r.Name!).ToList();
            var current = await UserManager.GetRolesAsync(user);
            selectedRoles = allRoles.ToDictionary(role => role, role => current.Contains(role));
        }
    }

    private async Task HandleSubmit()
    {
        if (user == null || selectedRoles == null) return;
        error = null;

        // Stop an admin from locking themselves (or everyone) out.
        var removingAdmin = !selectedRoles.GetValueOrDefault("Admin") && await UserManager.IsInRoleAsync(user, "Admin");
        if (removingAdmin)
        {
            if (string.Equals(user.UserName, currentUserName, StringComparison.OrdinalIgnoreCase))
            {
                error = "You cannot remove your own Admin role.";
                return;
            }
            if ((await UserManager.GetUsersInRoleAsync("Admin")).Count <= 1)
            {
                error = "You cannot remove the last administrator.";
                return;
            }
        }

        var rolesToAdd = selectedRoles.Where(r => r.Value).Select(r => r.Key).ToList();
        var rolesToRemove = selectedRoles.Where(r => !r.Value).Select(r => r.Key).ToList();

        var currentRoles = await UserManager.GetRolesAsync(user);
        var removeResult = await UserManager.RemoveFromRolesAsync(user, rolesToRemove.Where(r => currentRoles.Contains(r)));
        var addResult = await UserManager.AddToRolesAsync(user, rolesToAdd.Where(r => !currentRoles.Contains(r)));

        var errors = removeResult.Errors.Concat(addResult.Errors).Select(e => e.Description).ToList();
        if (errors.Count > 0)
        {
            error = string.Join("; ", errors);
            return;
        }

        NavigationManager.NavigateTo("/admin/users");
    }
}
