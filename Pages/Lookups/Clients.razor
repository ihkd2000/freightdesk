@page "/clients"
@inject AppDbContext DbContext

<LookupCrud TItem="Client" Subtitle="Customers who receive your notices" Title="Clients" ItemLabel="Client"
            LoadAsync="LoadItems" DisplayName="@(s => s.Name)"
            CreateAsync="CreateItem" UpdateAsync="UpdateItem" DeleteAsync="DeleteItem">
    <Fields Context="s">
        <div class="col-md-6">
            <label class="form-label">Name:</label>
            <InputText class="form-control" @bind-Value="s.Name" />
            <ValidationMessage For="@(() => s.Name)" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Job Reference:</label>
            <InputText class="form-control" @bind-Value="s.JobReference" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Email:</label>
            <InputText class="form-control" @bind-Value="s.Email" />
            <ValidationMessage For="@(() => s.Email)" />
        </div>
    </Fields>
    <Headers>
        <th>Name</th>
        <th>Job Reference</th>
        <th>Email</th>
    </Headers>
    <Cells Context="s">
        <td>@s.Name</td>
        <td>@s.JobReference</td>
        <td>@s.Email</td>
    </Cells>
</LookupCrud>

@code {
    private Task<List<Client>> LoadItems() =>
        DbContext.Clients.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

    private async Task<string?> CreateItem(Client item)
    {
        if (await IsDuplicate(item)) return "A client with this name and email already exists.";

        DbContext.Clients.Add(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private async Task<string?> UpdateItem(Client item)
    {
        if (await IsDuplicate(item)) return "A client with this name and email already exists.";

        DbContext.Clients.Update(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private async Task<string?> DeleteItem(Client item)
    {
        if (await DbContext.Shipments.AnyAsync(c => c.ClientId == item.Id))
        {
            return "This client cannot be deleted because containers still reference it.";
        }

        DbContext.Clients.Remove(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private Task<bool> IsDuplicate(Client item)
    {
        var name = (item.Name ?? string.Empty).Trim().ToLower();
        var email = (item.Email ?? string.Empty).Trim().ToLower();
        return DbContext.Clients.AnyAsync(s => s.Id != item.Id
                                                 && s.Name.ToLower() == name
                                                 && (s.Email ?? string.Empty).ToLower() == email);
    }
}
