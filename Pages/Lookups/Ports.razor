@page "/ports"
@inject AppDbContext DbContext

<LookupCrud TItem="Port" Subtitle="Destination ports used on shipments" Title="Ports" ItemLabel="Port"
            LoadAsync="LoadItems" DisplayName="@(d => d.Name)"
            CreateAsync="CreateItem" UpdateAsync="UpdateItem" DeleteAsync="DeleteItem">
    <Fields Context="d">
        <div class="col-md-6">
            <label class="form-label">Port name</label>
            <InputText class="form-control" @bind-Value="d.Name" />
            <ValidationMessage For="@(() => d.Name)" />
        </div>
    </Fields>
    <Headers>
        <th>Port</th>
    </Headers>
    <Cells Context="d">
        <td>@d.Name</td>
    </Cells>
</LookupCrud>

@code {
    private Task<List<Port>> LoadItems() =>
        DbContext.Ports.AsNoTracking().OrderBy(d => d.Name).ToListAsync();

    private async Task<string?> CreateItem(Port item)
    {
        if (await IsDuplicate(item)) return "A port with this name already exists.";

        DbContext.Ports.Add(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private async Task<string?> UpdateItem(Port item)
    {
        if (await IsDuplicate(item)) return "A port with this name already exists.";

        DbContext.Ports.Update(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private async Task<string?> DeleteItem(Port item)
    {
        if (await DbContext.Shipments.AnyAsync(c => c.PortId == item.Id))
        {
            return "This port cannot be deleted because containers still use it.";
        }

        DbContext.Ports.Remove(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private Task<bool> IsDuplicate(Port item)
    {
        var name = (item.Name ?? string.Empty).Trim().ToLower();
        return DbContext.Ports.AnyAsync(d => d.Id != item.Id && d.Name.ToLower() == name);
    }
}
