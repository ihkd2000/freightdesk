@page "/carriers"
@inject AppDbContext DbContext

<LookupCrud TItem="SteamShipLine" Subtitle="Shipping lines that carry your freight" Title="Carriers" ItemLabel="Carrier"
            LoadAsync="LoadItems" DisplayName="@(s => s.Name)"
            CreateAsync="CreateItem" UpdateAsync="UpdateItem" DeleteAsync="DeleteItem">
    <Fields Context="s">
        <div class="col-md-6">
            <label class="form-label">Name:</label>
            <InputText class="form-control" @bind-Value="s.Name" />
            <ValidationMessage For="@(() => s.Name)" />
        </div>
    </Fields>
    <Headers>
        <th>Name</th>
    </Headers>
    <Cells Context="s">
        <td>@s.Name</td>
    </Cells>
</LookupCrud>

@code {
    private Task<List<SteamShipLine>> LoadItems() =>
        DbContext.SteamShipLines.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

    private async Task<string?> CreateItem(SteamShipLine item)
    {
        if (await IsDuplicate(item)) return "A carrier with this name already exists.";

        DbContext.SteamShipLines.Add(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private async Task<string?> UpdateItem(SteamShipLine item)
    {
        if (await IsDuplicate(item)) return "A carrier with this name already exists.";

        DbContext.SteamShipLines.Update(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private async Task<string?> DeleteItem(SteamShipLine item)
    {
        if (await DbContext.Containers.AnyAsync(c => c.SteamShipLineId == item.Id))
        {
            return "This carrier cannot be deleted because containers still use it.";
        }

        DbContext.SteamShipLines.Remove(item);
        await DbContext.SaveChangesAsync();
        DbContext.ChangeTracker.Clear();
        return null;
    }

    private Task<bool> IsDuplicate(SteamShipLine item)
    {
        var name = (item.Name ?? string.Empty).Trim().ToLower();
        return DbContext.SteamShipLines.AnyAsync(s => s.Id != item.Id && s.Name.ToLower() == name);
    }
}
