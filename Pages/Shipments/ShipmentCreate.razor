@page "/shipments/new"
@implements IDisposable
@using System.Security.Claims
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject EmailDispatcher Dispatcher
@inject IConfiguration Configuration
@inject IOptions<BrandingOptions> Branding
@inject ILogger<ShipmentCreate> Logger

<PageTitle>New shipment</PageTitle>

<PageHeader Title="New shipment" Subtitle="Register a booking and notify the client">
    <a class="btn btn-outline-primary" href="/shipments"><span class="oi oi-arrow-left" aria-hidden="true"></span> Back to shipments</a>
</PageHeader>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")" role="alert">
        @message
        @if (savedId.HasValue)
        {
            <a class="ms-2" href="/shipments/@savedId">@(messageIsError ? "Open the existing shipment" : "View shipment")</a>
        }
        @if (!messageIsError)
        {
            <a class="ms-2" href="/shipments">All shipments</a>
        }
    </div>
}

<EditForm EditContext="@editContext" OnValidSubmit="Save" OnInvalidSubmit="ShowInvalid">
    <DataAnnotationsValidator />
    <ShipmentRulesValidator @ref="rules" IsNew="true" />

    <div class="row g-4">
        <div class="col-lg-8">
            <ShipmentFields Model="model" Clients="clients" Carriers="carriers" Ports="ports" ShowLifecycle="false"
                            MoreContainers="moreContainers" ContainersChanged="StateHasChanged"
                            OnQuickAdd="StartQuickAdd" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">@SaveLabel</button>
                <a class="btn btn-outline-secondary" href="/shipments">Cancel</a>
            </div>
        </div>
        <div class="col-lg-4">
            <ShipmentSummary Model="model" Client="SelectedClient" DuplicateId="duplicateId" ContainerNumbers="AllContainerNumbers"
                             @bind-NotifyClient="notifyClient"
                             Branding="Branding.Value" BankAccount="@Configuration["Billing:BankAccount"]"
                             ArrivalDaysBefore="arrivalDaysBefore" ReminderOffsets="reminderOffsets" />
        </div>
    </div>
</EditForm>

<QuickAddDialog Kind="quickAdd?.Kind" InitialName="@(quickAdd?.Name ?? "")" OnAdded="QuickAdded" OnCancel="() => quickAdd = null" />

@code {
    private Shipment model = new();
    private EditContext editContext = default!;
    private bool notifyClient = true;
    private int? duplicateId;
    private List<ContainerEntry> moreContainers = new();
    private QuickAddRequest? quickAdd;
    // The invoice number we filled in; if it is still untouched at save time it is re-read in case someone else took it.
    private int? suggestedInvoiceNo;
    private int arrivalDaysBefore;
    private int[] reminderOffsets = Array.Empty<int>();
    // Blazor Server shares one DbContext per circuit; the live duplicate check and Save must not overlap.
    private readonly SemaphoreSlim dbLock = new(1, 1);
    private ShipmentRulesValidator? rules;
    private int? savedId;
    private List<Client> clients = new();
    private List<Carrier> carriers = new();
    private List<Port> ports = new();
    private bool isSaving;
    private string? message;
    private bool messageIsError;

    private Client? SelectedClient => clients.FirstOrDefault(c => c.Id == model.ClientId);

    private IReadOnlyList<string> AllContainerNumbers =>
        new[] { model.ContainerNumber }.Concat(moreContainers.Select(c => c.Number))
            .Select(ShipmentRules.NormalizeContainerNumber)
            .Where(n => n.Length > 0)
            .ToList();

    private bool WillNotify => notifyClient && !string.IsNullOrWhiteSpace(SelectedClient?.Email);

    private string SaveLabel => isSaving ? "Saving..." : WillNotify ? "Save and email client" : "Save shipment";

    protected override async Task OnInitializedAsync()
    {
        arrivalDaysBefore = EmailSchedule.ArrivalDaysBefore(Configuration);
        reminderOffsets = EmailSchedule.ReminderOffsets(Configuration);
        ResetForm();
        await LoadLookupsAsync();
        await SuggestInvoiceAsync();
    }

    private async Task LoadLookupsAsync()
    {
        clients = await DbContext.Clients.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        carriers = await DbContext.Carriers.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        ports = await DbContext.Ports.AsNoTracking().OrderBy(d => d.Name).ToListAsync();
    }

    private async Task SuggestInvoiceAsync()
    {
        suggestedInvoiceNo = await ShipmentRules.NextInvoiceNumberAsync(DbContext);
        model.InvoiceNo = suggestedInvoiceNo;
        model.InvoiceDate = DateTime.Today;
    }

    private void StartQuickAdd(QuickAddRequest request) => quickAdd = request;

    private async Task QuickAdded(int id)
    {
        var kind = quickAdd!.Kind;
        quickAdd = null;
        await LoadLookupsAsync();
        switch (kind)
        {
            case QuickAddKind.Client:
                model.ClientId = id;
                editContext.NotifyFieldChanged(editContext.Field(nameof(Shipment.ClientId)));
                break;
            case QuickAddKind.Carrier:
                model.CarrierId = id;
                editContext.NotifyFieldChanged(editContext.Field(nameof(Shipment.CarrierId)));
                break;
            default:
                model.PortId = id;
                editContext.NotifyFieldChanged(editContext.Field(nameof(Shipment.PortId)));
                break;
        }
    }

    private void ResetForm()
    {
        if (editContext != null)
        {
            editContext.OnFieldChanged -= OnFieldChanged;
        }
        model = new Shipment();
        editContext = new EditContext(model);
        editContext.OnFieldChanged += OnFieldChanged;
        notifyClient = true;
        duplicateId = null;
        moreContainers = new List<ContainerEntry>();
    }

    private async void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.FieldName is not (nameof(Shipment.ContainerNumber) or nameof(Shipment.BookingNumber)))
        {
            StateHasChanged();
            return;
        }

        // async void: an event handler cannot be awaited, so failures are caught here.
        try
        {
            if (!await dbLock.WaitAsync(0)) return; // a save is running; it does its own check
            try
            {
                duplicateId = await ShipmentRules.FindDuplicateAsync(DbContext, model);
            }
            finally
            {
                dbLock.Release();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Live duplicate check failed.");
        }
    }

    /// <summary>Drops empty rows, normalises the numbers and flags bad or repeated ones. True when all are fine.</summary>
    private bool ValidateMoreContainers()
    {
        moreContainers.RemoveAll(c => string.IsNullOrWhiteSpace(c.Number));
        var seen = new HashSet<string> { ShipmentRules.NormalizeContainerNumber(model.ContainerNumber) };
        foreach (var entry in moreContainers)
        {
            entry.Number = ShipmentRules.NormalizeContainerNumber(entry.Number);
            entry.Error = ShipmentRules.ContainerNumberError(entry.Number)
                          ?? (seen.Add(entry.Number) ? null : "This container is already listed.");
        }
        return moreContainers.All(c => c.Error == null);
    }

    private void ShowInvalid()
    {
        ValidateMoreContainers();
        message = "Please fix the highlighted fields.";
        messageIsError = true;
        savedId = null;
    }

    private async Task Save()
    {
        isSaving = true;
        message = null;
        savedId = null;
        await dbLock.WaitAsync();

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                NavigationManager.NavigateTo("Identity/Account/Login", forceLoad: true);
                return;
            }

            model.ContainerNumber = ShipmentRules.NormalizeContainerNumber(model.ContainerNumber);
            model.BookingNumber = model.BookingNumber.Trim();
            model.JobReferenceNumber = model.JobReferenceNumber.Trim();

            if (!ValidateMoreContainers())
            {
                ShowInvalid();
                return;
            }

            duplicateId = await ShipmentRules.FindDuplicateAsync(DbContext, model);
            if (duplicateId.HasValue)
            {
                rules?.AddError(nameof(Shipment.ContainerNumber),
                    $"Container {model.ContainerNumber} is already registered on booking {model.BookingNumber}.");
                message = "This shipment already exists.";
                messageIsError = true;
                savedId = duplicateId;
                return;
            }

            if (model.InvoiceNo == suggestedInvoiceNo)
            {
                model.InvoiceNo = await ShipmentRules.NextInvoiceNumberAsync(DbContext);
            }

            model.Owner = userId;
            var shipments = new List<Shipment> { model };
            shipments.AddRange(moreContainers.Select(c => model.CopyForContainer(c.Number)));

            var anyDuplicate = false;
            foreach (var (entry, shipment) in moreContainers.Zip(shipments.Skip(1)))
            {
                if (await ShipmentRules.FindDuplicateAsync(DbContext, shipment) is int id)
                {
                    entry.Error = $"Already registered on booking {shipment.BookingNumber} (shipment #{id}).";
                    anyDuplicate = true;
                }
            }
            if (anyDuplicate)
            {
                message = "Some containers are already registered on this booking.";
                messageIsError = true;
                return;
            }

            // One SaveChanges, so either every container on the booking is saved or none is.
            DbContext.Shipments.AddRange(shipments);
            await DbContext.SaveChangesAsync();

            var notify = WillNotify;
            var containers = shipments.Select(s => s.ContainerNumber).ToList();
            savedId = shipments.Count == 1 ? model.Id : null;
            ResetForm();

            await SuggestInvoiceAsync();

            var what = containers.Count == 1
                ? $"Shipment {containers[0]}"
                : $"{containers.Count} shipments on booking {shipments[0].BookingNumber}";
            if (!notify)
            {
                message = $"{what} saved. The client was not emailed.";
            }
            else
            {
                message = await NotifyClientAsync(shipments[0], containers)
                    ? $"{what} saved and the client was emailed."
                    : $"{what} saved, but the email could not be sent. You can resend it from the email log.";
            }
            messageIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save shipment.");
            // Forget the failed inserts so a retry does not add them twice.
            foreach (var entry in DbContext.ChangeTracker.Entries<Shipment>().Where(e => e.State == EntityState.Added).ToList())
            {
                entry.State = EntityState.Detached;
            }
            message = "Could not save the shipment. Please try again; if it keeps failing, check the application log.";
            messageIsError = true;
        }
        finally
        {
            dbLock.Release();
            isSaving = false;
        }
    }

    private async Task<bool> NotifyClientAsync(Shipment saved, IReadOnlyList<string> containers)
    {
        try
        {
            var client = await DbContext.Clients.AsNoTracking().FirstOrDefaultAsync(s => s.Id == saved.ClientId);
            if (client == null || string.IsNullOrWhiteSpace(client.Email))
            {
                return false;
            }

            var email = EmailTemplates.ShipmentRegistered(
                Branding.Value, client.Name, saved, Configuration["Billing:BankAccount"], DateTime.Now, containers);

            var result = await Dispatcher.SendAsync(EmailKinds.ShipmentRegistered, client.Email,
                email.Subject, email.Text, email.Html, saved.Id);
            return result.Success;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not send the registration email for {ContainerNumber}.", saved.ContainerNumber);
            return false;
        }
    }

    public void Dispose()
    {
        editContext.OnFieldChanged -= OnFieldChanged;
        dbLock.Dispose();
    }
}
