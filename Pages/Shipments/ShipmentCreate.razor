@page "/shipments/new"
@implements IDisposable
@using System.Security.Claims
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject EmailDispatcher Dispatcher
@inject IConfiguration Configuration
@inject IOptions<BrandingOptions> Branding
@inject ILogger<ShipmentCreate> Logger

<PageTitle>New shipment</PageTitle>

<PageHeader Title="New shipment" Subtitle="Register a booking and notify the client">
    <a class="btn btn-outline-primary" href="/shipments"><span class="oi oi-arrow-left" aria-hidden="true"></span> Back to shipments</a>
</PageHeader>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success")" role="alert">
        @message
        @if (savedId.HasValue)
        {
            <a class="ms-2" href="/shipments/@savedId">@(messageIsError ? "Open the existing shipment" : "View shipment")</a>
        }
        @if (!messageIsError)
        {
            <a class="ms-2" href="/shipments">All shipments</a>
        }
    </div>
}

<EditForm EditContext="@editContext" OnValidSubmit="Save" OnInvalidSubmit="ShowInvalid">
    <DataAnnotationsValidator />
    <ShipmentRulesValidator @ref="rules" IsNew="true" />

    <div class="row g-4">
        <div class="col-lg-8">
            <ShipmentFields Model="model" Clients="clients" Carriers="carriers" Ports="ports" ShowLifecycle="false" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@isSaving">@SaveLabel</button>
                <a class="btn btn-outline-secondary" href="/shipments">Cancel</a>
            </div>
        </div>
        <div class="col-lg-4">
            <ShipmentSummary Model="model" Client="SelectedClient" DuplicateId="duplicateId"
                             @bind-NotifyClient="notifyClient"
                             Branding="Branding.Value" BankAccount="@Configuration["Billing:BankAccount"]"
                             ArrivalDaysBefore="arrivalDaysBefore" ReminderOffsets="reminderOffsets" />
        </div>
    </div>
</EditForm>

@code {
    private Shipment model = new();
    private EditContext editContext = default!;
    private bool notifyClient = true;
    private int? duplicateId;
    private int arrivalDaysBefore;
    private int[] reminderOffsets = Array.Empty<int>();
    // Blazor Server shares one DbContext per circuit; the live duplicate check and Save must not overlap.
    private readonly SemaphoreSlim dbLock = new(1, 1);
    private ShipmentRulesValidator? rules;
    private int? savedId;
    private List<Client> clients = new();
    private List<Carrier> carriers = new();
    private List<Port> ports = new();
    private bool isSaving;
    private string? message;
    private bool messageIsError;

    private Client? SelectedClient => clients.FirstOrDefault(c => c.Id == model.ClientId);

    private bool WillNotify => notifyClient && !string.IsNullOrWhiteSpace(SelectedClient?.Email);

    private string SaveLabel => isSaving ? "Saving..." : WillNotify ? "Save and email client" : "Save shipment";

    protected override async Task OnInitializedAsync()
    {
        arrivalDaysBefore = EmailSchedule.ArrivalDaysBefore(Configuration);
        reminderOffsets = EmailSchedule.ReminderOffsets(Configuration);
        ResetForm();

        clients = await DbContext.Clients.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        carriers = await DbContext.Carriers.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        ports = await DbContext.Ports.AsNoTracking().OrderBy(d => d.Name).ToListAsync();
    }

    private void ResetForm()
    {
        if (editContext != null)
        {
            editContext.OnFieldChanged -= OnFieldChanged;
        }
        model = new Shipment();
        editContext = new EditContext(model);
        editContext.OnFieldChanged += OnFieldChanged;
        notifyClient = true;
        duplicateId = null;
    }

    private async void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (e.FieldIdentifier.FieldName is not (nameof(Shipment.ContainerNumber) or nameof(Shipment.BookingNumber)))
        {
            StateHasChanged();
            return;
        }

        // async void: an event handler cannot be awaited, so failures are caught here.
        try
        {
            if (!await dbLock.WaitAsync(0)) return; // a save is running; it does its own check
            try
            {
                duplicateId = await ShipmentRules.FindDuplicateAsync(DbContext, model);
            }
            finally
            {
                dbLock.Release();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Live duplicate check failed.");
        }
    }

    private void ShowInvalid()
    {
        message = "Please fix the highlighted fields.";
        messageIsError = true;
        savedId = null;
    }

    private async Task Save()
    {
        isSaving = true;
        message = null;
        savedId = null;
        await dbLock.WaitAsync();

        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                NavigationManager.NavigateTo("Identity/Account/Login", forceLoad: true);
                return;
            }

            model.ContainerNumber = ShipmentRules.NormalizeContainerNumber(model.ContainerNumber);
            model.BookingNumber = model.BookingNumber.Trim();
            model.JobReferenceNumber = model.JobReferenceNumber.Trim();

            duplicateId = await ShipmentRules.FindDuplicateAsync(DbContext, model);
            if (duplicateId.HasValue)
            {
                rules?.AddError(nameof(Shipment.ContainerNumber),
                    $"Container {model.ContainerNumber} is already registered on booking {model.BookingNumber}.");
                message = "This shipment already exists.";
                messageIsError = true;
                savedId = duplicateId;
                return;
            }

            model.Owner = userId;
            DbContext.Shipments.Add(model);
            await DbContext.SaveChangesAsync();

            var saved = model;
            var notify = WillNotify;
            savedId = saved.Id;
            ResetForm();

            if (!notify)
            {
                message = $"Shipment {saved.ContainerNumber} saved. The client was not emailed.";
            }
            else
            {
                message = await NotifyClientAsync(saved)
                    ? $"Shipment {saved.ContainerNumber} saved and the client was emailed."
                    : $"Shipment {saved.ContainerNumber} saved, but the email could not be sent. You can resend it from the email log.";
            }
            messageIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save shipment.");
            message = "Could not save the shipment. Please try again; if it keeps failing, check the application log.";
            messageIsError = true;
        }
        finally
        {
            dbLock.Release();
            isSaving = false;
        }
    }

    private async Task<bool> NotifyClientAsync(Shipment saved)
    {
        try
        {
            var client = await DbContext.Clients.AsNoTracking().FirstOrDefaultAsync(s => s.Id == saved.ClientId);
            if (client == null || string.IsNullOrWhiteSpace(client.Email))
            {
                return false;
            }

            var email = EmailTemplates.ShipmentRegistered(
                Branding.Value, client.Name, saved, Configuration["Billing:BankAccount"], DateTime.Now);

            var result = await Dispatcher.SendAsync(EmailKinds.ShipmentRegistered, client.Email,
                email.Subject, email.Text, email.Html, saved.Id);
            return result.Success;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not send the registration email for {ContainerNumber}.", saved.ContainerNumber);
            return false;
        }
    }

    public void Dispose()
    {
        editContext.OnFieldChanged -= OnFieldChanged;
        dbLock.Dispose();
    }
}
